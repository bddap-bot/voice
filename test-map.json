{
  "about": "Touched-path \u2192 test-suite map, read by `botq test-map`. First matching rule wins; `tests: []` means consciously untested and must carry its why.",
  "rules": [
    {
      "paths": [
        "vr/**"
      ],
      "tests": [
        "nix-build vr/default.nix --no-out-link",
        "nix-build vr/default.nix -A bundle --no-out-link",
        "nix-build vr/default.nix -A simulatedController --no-out-link",
        "nix-build vr/default.nix -A harness --no-out-link"
      ],
      "why": "the overlay host's build runs its unit tests and offscreen-render tests on a software Vulkan device, and wraps the runtime libraries SteamVR's client needs; the headset bundle's build checks its architecture, loader, libraries and glibc floor; the simulated controller driver builds"
    },
    {
      "paths": [
        "scripts/vr-golden.mjs"
      ],
      "tests": [
        "node --check scripts/vr-golden.mjs",
        "nix-build vr/default.nix --no-out-link"
      ],
      "why": "the script writes the page's golden render that the overlay host's build compares its own render against"
    },
    {
      "paths": [
        "scripts/vr-wake-golden.mjs"
      ],
      "tests": [
        "node --check scripts/vr-wake-golden.mjs",
        "node scripts/vr-wake-golden.mjs && git diff --exit-code vr/golden/wake.json",
        "nix-build vr/default.nix --no-out-link"
      ],
      "why": "the script writes the page spotter's golden that the overlay host's build compares its own features, scores and decisions against"
    },
    {
      "paths": [
        "scripts/vr-speaker-golden.mjs"
      ],
      "tests": [
        "node --check scripts/vr-speaker-golden.mjs",
        "node scripts/vr-speaker-golden.mjs && git diff --exit-code vr/golden/speaker.json",
        "nix-build vr/default.nix --no-out-link"
      ],
      "why": "the script writes the page speaker filter's golden that the overlay host's build compares its own features, detections and gate decisions against"
    },
    {
      "paths": [
        "android/**"
      ],
      "tests": [
        "bash -n android/build.sh",
        "node --check android/test/background.mjs",
        "node --check android/test/appearance.mjs",
        "node --check android/test/microphone.mjs",
        "bash android/build.sh --test"
      ],
      "why": "Compile, package, align and verify the signed Android host with SDK 35 and a private signing key."
    },
    {
      "paths": [
        "AGENTS.md"
      ],
      "tests": [],
      "why": "Contributor prose; no executable behavior."
    },
    {
      "paths": [
        "scripts/pack-puppets.py",
        "test/pack-puppets.py"
      ],
      "tests": [
        "nix-shell -p python3 imagemagick libwebp oxipng --run 'python3 test/pack-puppets.py'"
      ],
      "why": "Exercise exact transparent texels, required WebP extension, sparse morph decoding, and unchanged untextured models."
    },
    {
      "paths": [
        "test/action-evaluation.js"
      ],
      "tests": [
        "node test/action-evaluation.js"
      ],
      "why": "the real embedding model must reach every action token from natural conversational sentences"
    },
    {
      "paths": [
        "docs/puppet-drivers.js"
      ],
      "tests": [
        "npm run build",
        "node test/action-evaluation.js",
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run smoke:ci"
      ],
      "why": "Classifier changes must pass real-model embedding invariance and action evaluation as well as browser coverage."
    },
    {
      "paths": [
        "docs/poses/standing.json"
      ],
      "tests": [
        "npm run build",
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run smoke:ci",
        "nix-build vr/default.nix --no-out-link",
        "nix-build vr/default.nix -A bundle --no-out-link",
        "nix-build vr/default.nix -A simulatedController --no-out-link"
      ],
      "why": "the rest pose is read by the page and compiled into the native overlay host"
    },
    {
      "paths": [
        "docs/speaker.js"
      ],
      "tests": [
        "npm run build",
        "node scripts/vr-speaker-golden.mjs && git diff --exit-code vr/golden/speaker.json",
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run smoke:ci",
        "nix-build vr/default.nix --no-out-link",
        "nix-build vr/default.nix -A bundle --no-out-link",
        "nix-build vr/default.nix -A simulatedController --no-out-link"
      ],
      "why": "the speaker filter is run by the page and read by the native overlay host, which parses its constants, pins its model and compares against its golden"
    },
    {
      "paths": [
        "docs/wake.js",
        "docs/wake/**",
        "scripts/wake-demo.json",
        "docs/identity.js",
        "scripts/wake.mjs"
      ],
      "tests": [
        "npm run build",
        "node scripts/vr-wake-golden.mjs && git diff --exit-code vr/golden/wake.json",
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run smoke:ci",
        "nix-build vr/default.nix --no-out-link",
        "nix-build vr/default.nix -A bundle --no-out-link",
        "nix-build vr/default.nix -A simulatedController --no-out-link"
      ],
      "why": "the wake spotter, its models, the demo model, the trainer and the phrases are run by the page and compiled into or compared by the native overlay host"
    },
    {
      "paths": [
        "scripts/speaker-print.mjs"
      ],
      "tests": [
        "node --check scripts/speaker-print.mjs",
        "node --test test/speaker.test.js"
      ],
      "why": "the script builds a voiceprint file from recordings; the speaker tests cover the choice of the voice it keeps"
    },
    {
      "paths": [
        "docs/**",
        "src/**",
        "scripts/build.mjs",
        "scripts/dev.mjs",
        "scripts/smoke.mjs",
        "scripts/chromium.mjs",
        "scripts/wake-reply-smoke.mjs",
        "scripts/delegated-reply-smoke.mjs",
        "scripts/live-rig.mjs",
        "scripts/wake.mjs",
        "scripts/wake-demo.json",
        "scripts/avatar-load.jq",
        "test/**",
        "package.json",
        "package-lock.json",
        ".github/workflows/smoke.yml",
        ".github/workflows/pages.yml",
        "DESIGN.md"
      ],
      "tests": [
        "npm run build",
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run smoke:ci"
      ],
      "why": "browser assets, build inputs, smoke measurements, baseline, and gate configuration must pass the same browser smoke as CI; display coverage includes table rows, inline links, and pipes inside code"
    },
    {
      "paths": [
        "README.md",
        ".gitignore"
      ],
      "tests": [],
      "why": "prose"
    }
  ]
}
