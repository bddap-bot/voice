{
  "about": "Touched-path \u2192 test-suite map, read by `botq test-map`. First matching rule wins; `tests: []` means consciously untested and must carry its why.",
  "rules": [
    {
      "paths": [
        "AGENTS.md"
      ],
      "tests": [],
      "why": "Contributor prose; no executable behavior."
    },
    {
      "paths": [
        "test/action-evaluation.js"
      ],
      "tests": [
        "node test/action-evaluation.js"
      ],
      "why": "the real embedding model must reach every action token from natural conversational sentences"
    },
    {
      "paths": [
        "docs/puppet-drivers.js"
      ],
      "tests": [
        "node test/action-evaluation.js",
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run build",
        "npm run smoke:ci"
      ],
      "why": "Classifier changes must pass real-model embedding invariance and action evaluation as well as browser coverage."
    },
    {
      "paths": [
        "docs/**",
        "src/**",
        "scripts/build.mjs",
        "scripts/dev.mjs",
        "scripts/smoke.mjs",
        "scripts/chromium.mjs",
        "scripts/wake.mjs",
        "scripts/wake-demo.json",
        "test/**",
        "package.json",
        "package-lock.json",
        ".github/workflows/smoke.yml",
        "test-map.json",
        "DESIGN.md"
      ],
      "tests": [
        "node --test --test-name-pattern='display pipe tables' test/page.test.js",
        "npm test",
        "npm run build",
        "npm run smoke:ci"
      ],
      "why": "browser assets, build inputs, smoke measurements, baseline, and gate configuration must pass the same browser smoke as CI; display coverage includes table rows, inline links, and pipes inside code"
    },
    {
      "paths": [
        "README.md",
        ".gitignore"
      ],
      "tests": [],
      "why": "prose"
    }
  ]
}
